{
  "schemaVersion": 1,
  "id": "modernui",
  "version": "${version}",
  "name": "${display_name}",
  "description": "ModernUI Lumen is an independently maintained fork of Modern UI for Minecraft by BloCamLimb. Maintained by MOPELotus, it provides the ModernUI framework integration, enhanced text rendering and UI features for Minecraft. This fork is not an official upstream release.",
  "authors": [
    "BloCamLimb",
    "MOPELotus"
  ],
  "contributors": [
    "The Android Open Source Project"
  ],
  "contact": {
    "homepage": "https://github.com/MOPELotus/ModernUI-MC-Lumen",
    "issues": "https://github.com/MOPELotus/ModernUI-MC-Lumen/issues",
    "sources": "https://github.com/MOPELotus/ModernUI-MC-Lumen"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "modernui_logo.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "icyllis.modernui.mc.fabric.ModernUIFabric"
    ],
    "client": [
      "icyllis.modernui.mc.fabric.ModernUIFabricClient"
    ],
    "modmenu": [
      "icyllis.modernui.mc.fabric.MuiModMenuApi"
    ]
  },
  "mixins": [
    "mixins.modernui-fabric.json",
    "mixins.modernui-textmc.json"
  ],
  "accessWidener" : "modernui.accesswidener",
  "depends": {
    "mixinextras": ">=0.5.5",
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21.9 <1.21.10",
    "java": ">=21",
    "fabric-api": ">=0.90.7"
  },
  "conflicts": {
    "blur": "*",
    "tipthescales": "*"
  }
}
